      "versionNonce": 1733486901,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773624742463,
      "link": null,
      "locked": false,
      "text": "Functional reqs\n- Generate short url from long url -> shortening\n- Retrieve pages associated with short url -> redirect\n- Track access and creation -> link analytics",
      "fontSize": 16.52708333333333,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional reqs\n- Generate short url from long url -> shortening\n- Retrieve pages associated with short url -> redirect\n- Track access and creation -> link analytics",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "qk46g4byszleA-ep1IMIM",
      "type": "text",
      "x": 368.5145568847656,
      "y": 701.56640625,
      "width": 541.4396362304688,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
