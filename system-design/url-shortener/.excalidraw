      "seed": 2018375643,
      "version": 444,
      "versionNonce": 445853851,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773624742463,
      "link": null,
      "locked": false,
      "text": "Non-functional reqs\n- Low latency\n- High Availability\n- Read heavy; users will access short url after creation",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-functional reqs\n- Low latency\n- High Availability\n- Read heavy; users will access short url after creation",
      "autoResize": true,
      "lineHeight": 1.25
    },
