      "x": 427.36010742187494,
      "y": 586.375,
      "width": 436.34228515625,
      "height": 82.63541666666666,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
